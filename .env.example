# Required ---------------------------------------------------------------
# HeyGen — avatar render + TTS with word-level timestamps.
# https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=

# Pexels — primary b-roll source (free, commercial use).
# https://www.pexels.com/api/new/
PEXELS_API_KEY=

# Optional ---------------------------------------------------------------
# Pixabay — secondary b-roll source, used when Pexels has nothing on-topic.
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Generative b-roll fallback. If unset, the pipeline falls back to a
# designed motion-graphics card instead of a generated clip.
FAL_KEY=
REPLICATE_API_TOKEN=

# Defaults ---------------------------------------------------------------
# Discover valid ids with: uv run scripts/doctor.py --list-avatars
QUINN_AVATAR_ID=
QUINN_VOICE_ID=
