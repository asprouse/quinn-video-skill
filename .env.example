# Required -----------------------------------------------------------------
# HeyGen — avatar render + TTS with word-level timestamps.
# https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=

# Pexels — primary b-roll source (free, commercial use).
# https://www.pexels.com/api/new/
PEXELS_API_KEY=

# Optional -------------------------------------------------------------
# Pixabay — secondary b-roll source, used when Pexels has nothing on-topic.
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Generative b-roll and music. If unset, the pipeline falls back to a
# designed motion-graphics card instead of a generated clip, and ships with
# no music bed.
FAL_KEY=

# Presenter --------------------------------------------------------------
# Set by `quinn-video presenters <heygen-url>` — paste a link from
# https://app.heygen.com/avatars and it writes both of these for you.
QUINN_AVATAR_ID=
QUINN_VOICE_ID=

# Tuning — all optional, all have sane defaults ---------------------------
# Target video length in seconds (30-60, default 45). Avatar rendering is
# billed per second, so work at the short end while iterating.
# QUINN_TARGET_SECONDS=45

# Delivery speed passed to HeyGen (default 1.0, which lands 167-180 wpm on a
# real script). `narrate` measures the actual rate and tells you what to set
# this to if a script comes out too fast or too slow — set it per run in
# state, not here, unless every video should read at the same pace.
# QUINN_VOICE_SPEED=1.0

# Longest a single b-roll shot holds before cutting, in seconds (default 7).
# QUINN_MAX_SHOT=7.0

# How long the closing frame holds after the last word, in seconds (default
# 0.7). Short-form autoplays in a loop; this is the room the last line needs
# to land before the hook comes round again.
# QUINN_TAIL=0.7

# Assumed words-per-minute when estimating a script's runtime before
# narrating (default 170). Only affects the estimate shown at `check` and
# `plan` — the real duration always comes from the narration.
# QUINN_TARGET_WPM=170

# Motion direction sent with every avatar render (has a default). Change it
# to alter how animated the presenter reads.
# QUINN_MOTION_PROMPT="Energetic, confident delivery. ..."

# Workspace and fonts ------------------------------------------------------
# Where runs, .quinn-cache and this .env live. Set automatically by the
# skill's setup step; only needed if running the CLI directly outside it.
# QUINN_WORKSPACE=/path/to/your/project

# Where downloaded caption fonts are cached (default ~/.cache/quinn-video/fonts).
# QUINN_FONT_DIR=

# Escape hatches -----------------------------------------------------------
# Skip the doctor preflight that `init` runs automatically. Only for
# debugging the preflight itself — leaving this set hides real blockers.
# QUINN_SKIP_PREFLIGHT=
